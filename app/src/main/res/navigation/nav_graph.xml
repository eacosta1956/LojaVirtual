<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.eldon.lojavirtual.presentation.home.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_productsFragment"
            app:destination="@id/productsFragment" />

        <action
            android:id="@+id/action_homeFragment_to_cartsFragment"
            app:destination="@id/cartsFragment" />

        <action
            android:id="@+id/action_homeFragment_to_usersFragment"
            app:destination="@id/usersFragment" />

        <action
            android:id="@+id/action_homeFragment_to_postsFragment"
            app:destination="@id/postsFragment" />

    </fragment>

    <fragment
        android:id="@+id/productsFragment"
        android:name="com.eldon.lojavirtual.presentation.products.ProductsFragment"
        android:label="@string/products_title">

        <action
            android:id="@+id/action_productsFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.eldon.lojavirtual.presentation.productdetail.ProductDetailFragment"
        android:label="Detalhe do produto">

        <argument
            android:name="product_id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/cartsFragment"
        android:name="com.eldon.lojavirtual.presentation.carts.CartsFragment"
        android:label="Carrinhos" />

    <action
        android:id="@+id/action_cartsFragment_to_cartDetailFragment"
        app:destination="@id/cartDetailFragment" />

    <fragment
        android:id="@+id/cartDetailFragment"
        android:name="com.eldon.lojavirtual.presentation.cartdetail.CartDetailFragment"
        android:label="Detalhe do carrinho">

        <argument
            android:name="cart_id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/usersFragment"
        android:name="com.eldon.lojavirtual.presentation.users.UsersFragment"
        android:label="Usuários" />

    <action
        android:id="@+id/action_usersFragment_to_userDetailFragment"
        app:destination="@id/userDetailFragment" />

    <fragment
        android:id="@+id/userDetailFragment"
        android:name="com.eldon.lojavirtual.presentation.userdetail.UserDetailFragment"
        android:label="Detalhe do usuário">

        <argument
            android:name="user_id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/postsFragment"
        android:name="com.eldon.lojavirtual.presentation.posts.PostsFragment"
        android:label="Postagens" />

    <action
        android:id="@+id/action_postsFragment_to_postDetailFragment"
        app:destination="@id/postDetailFragment" />

    <fragment
        android:id="@+id/postDetailFragment"
        android:name="com.eldon.lojavirtual.presentation.postdetail.PostDetailFragment"
        android:label="Detalhe da postagem">

        <argument
            android:name="post_id"
            app:argType="integer" />
    </fragment>

</navigation>